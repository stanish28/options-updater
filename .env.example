# Copy this file to .env and fill in real values. .env is gitignored.

# Google Sheet ID (the long string in the sheet URL between /d/ and /edit)
SHEET_ID=your_google_sheet_id_here

# Name of the main tab in the sheet (where prices are written)
MAIN_TAB=Sheet1

# Name of the config tab (created during setup)
CONFIG_TAB=Config

# Path to the Google service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Robinhood credentials — used only by sync_positions.py (local-only, never sent to cloud)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Only needed if you have multiple individual accounts under one login (Robinhood's "multiple investing accounts" feature).
# Find via app: Account icon -> Menu -> Account No. -> Show numbers. Leave blank to use the default account.
ROBINHOOD_ACCOUNT_NUMBER=

# Optional flags for testing
# DRY_RUN=1            # print what would be written, don't mutate the sheet
# ONLY_ROW=16          # update just one main-sheet row (matched by MainSheetRow in Config)
# SKIP_HOLIDAY_CHECK=1 # bypass the NYSE holiday check (useful for off-hours testing)
