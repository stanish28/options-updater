# Copy this file to .env and fill in real values. .env is gitignored.

# --- Google Sheets ---
# The long ID between /d/ and /edit in your sheet URL.
# Example: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=your_google_sheet_id_here

# Absolute path to your Google service-account JSON key file.
# See README "Step 3: Google service account" for how to create it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Robinhood ---
ROBINHOOD_USERNAME=your_robinhood_email@example.com
ROBINHOOD_PASSWORD=your_robinhood_password

# Optional. Only needed if you use Robinhood's "multiple investing accounts"
# feature (Bhuvan / Joint / Retirement / Custodial tabs in the app).
# Find via app: Account icon -> Menu -> Account No. -> Show numbers.
# Leave blank to use the default account.
ROBINHOOD_ACCOUNT_NUMBER=

# --- Telegram trigger bot (optional; only for telegram_bot.py) ---
# Create a bot with @BotFather in Telegram, then paste the token it gives you.
TELEGRAM_BOT_TOKEN=
# Your personal Telegram chat ID — the ONLY account allowed to run /sync.
# Discover it by messaging your bot "/id" once the bot is running, or via
# https://api.telegram.org/bot<TOKEN>/getUpdates after you send it a message.
TELEGRAM_ALLOWED_CHAT_ID=
